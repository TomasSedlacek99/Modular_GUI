    - target: {fileID: 6930810734943986774, guid: cca6164bb2744884a92a100266f5f3aa, type: 3}
      propertyPath: m_text
      value: "Multiprocesorov\xE1 stanica sp\xE1ja v\u0161etky mo\u017En\xE9 prvky
        opracovania obrobku. Pozost\xE1va z pece s pneumatick\xFDmi posuvn\xFDmi
        dverami, spracovate\u013Eskej stanice s pneumatick\xFDm meni\u010Dom vr\xE1tane
        pr\xEDsavky a  fr\xE9zky s oto\u010Dn\xFDm stolom s dopravn\xEDkov\xFDm p\xE1som.
        S\xFA\u010Das\u0165ou jednotky je aj senzorick\xE1 jednotka a pohybliv\xE1
        kamera. "
      objectReference: {fileID: 0}
